# Cloud Functions configuration. Copy to .env and fill in.
#
# Secrets do NOT belong here. Set them once with the CLI, which stores them in
# Secret Manager and binds them to the functions that declare them:
#
#   firebase functions:secrets:set WHATSAPP_ACCESS_TOKEN
#   firebase functions:secrets:set WHATSAPP_WEBHOOK_VERIFY_TOKEN
#   firebase functions:secrets:set WHATSAPP_WEBHOOK_APP_SECRET
#
# WHATSAPP_ACCESS_TOKEN must be the System User token from Business Settings,
# not the temporary one on the WhatsApp API Setup page. The temporary token
# lasts 24 hours, after which every reminder fails until someone notices.

# ---------------------------------------------------------------- WhatsApp
# One CruDoc number sends appointment reminders on behalf of every clinic.
# See docs/whatsapp_shared_number.md.

# live     sends for real
# dry_run  sends nothing, and records every reminder as skipped. Never reports
#          a message as sent that was not sent.
WHATSAPP_MODE=live

# WhatsApp Manager -> Phone numbers. The number messages come from.
WHATSAPP_PHONE_NUMBER_ID=

# The approved template. Its body and parameter order live in
# functions/src/whatsapp/templates.ts and must match what Meta approved.
WHATSAPP_TEMPLATE_NAME=appointment_reminder_v1

# Pinned so a Graph API deprecation is a config change, not a code change.
WHATSAPP_GRAPH_VERSION=v23.0
