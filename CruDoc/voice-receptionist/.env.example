# ── AI Service Keys ──────────────────────────────────────────────────
# Sarvam AI — speech-to-text and text-to-speech
SARVAM_API_KEY=

# Google Gemini — LLM for conversation
GOOGLE_API_KEY=

# ── Twilio ───────────────────────────────────────────────────────────
# Account credentials (from https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The Twilio phone number callers will dial (E.164 format, e.g. +14155551234)
TWILIO_NUMBER=

# Where to transfer calls when the bot can't help (E.164 format)
RECEPTIONIST_NUMBER=

# ── CruDoc Backend ───────────────────────────────────────────────────
# Full URL to the createAppointment Cloud Function endpoint, e.g.:
# https://asia-south1-svayatta-crudoc-dev.cloudfunctions.net/createAppointment
CRUDOC_APPOINTMENTS_API=

# The doctor UID whose calendar receives AI-booked appointments
CRUDOC_DOCTOR_ID=

# Shared API key that the Cloud Function checks (must match the
# VOICE_BOT_API_KEY configured on the Cloud Function side)
VOICE_BOT_API_KEY=
