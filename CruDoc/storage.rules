rules_version = '2';

// Firebase Cloud Storage rules for CruDoc.
//
// Every object lives under the owning doctor's uid. The client-side
// counterpart is lib/core/services/medical_storage_service.dart — keep the
// size cap and content-type lists below in sync with it.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(doctorId) {
      return request.auth != null && request.auth.uid == doctorId;
    }

    function withinSizeLimit() {
      return request.resource.size <= 15 * 1024 * 1024;
    }

    function isAllowedMedicalType() {
      return request.resource.contentType in [
        'image/jpeg',
        'image/png',
        'image/webp',
        'application/pdf',
        'audio/mp4',
        'audio/aac',
        'audio/opus',
        'text/csv'
      ];
    }

    function isAllowedAudioType() {
      return request.resource.contentType in [
        'audio/mp4',
        'audio/aac',
        'audio/opus'
      ];
    }

    // Default deny: anything not matched below is unreachable.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Permanent per-doctor files: patient records, clinic branding,
    // inventory receipts, sterilization strips, backups, exports.
    match /doctors/{doctorId}/{allPaths=**} {
      allow read, delete: if isOwner(doctorId);
      allow create, update: if isOwner(doctorId)
        && withinSizeLimit()
        && isAllowedMedicalType();
    }

    // Diagnostic originals from the radiology module: one DICOM instance
    // (or TIFF) per object, stored byte for byte. Larger limit than other
    // files; the type is accepted here only.
    match /doctors/{doctorId}/patients/{patientId}/clinical/imaging/{allPaths=**} {
      allow create, update: if isOwner(doctorId)
        && request.resource.size <= 250 * 1024 * 1024
        && request.resource.contentType in ['application/dicom', 'image/tiff'];
    }

    // Encrypted database backups (.enc) are opaque bytes. octet-stream is
    // accepted here only, so it can't be used to slip arbitrary files into
    // patient folders.
    match /doctors/{doctorId}/backups/{allPaths=**} {
      allow create, update: if isOwner(doctorId)
        && withinSizeLimit()
        && request.resource.contentType == 'application/octet-stream';
    }

    // Ephemeral voice dictation awaiting transcription. Write-once:
    // no update, so a recording can't be swapped after upload.
    match /voice-scratch/doctors/{doctorId}/{allPaths=**} {
      allow read, delete: if isOwner(doctorId);
      allow create: if isOwner(doctorId)
        && withinSizeLimit()
        && isAllowedAudioType();
    }
  }
}
