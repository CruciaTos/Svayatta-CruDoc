# --- Application-level secrets/config ONLY. No tenant data here. ---
APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=sqlite+aiosqlite:///./voice_receptionist.db
REDIS_URL=

# Sarvam TTS model. bulbul:v2 is deprecated server-side.
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_API_KEY=
# Gemini model used for the conversation. Verified reliable with tool calling
# at ~1.4s/turn; gemini-3.5-flash-lite is ~0.8s if you want lower latency.
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Base URL Twilio uses to reach this service (ngrok URL in dev)
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# INBOUND guard for this service's own management endpoints (clinic, doctor
# and phone-number provisioning). Callers send it as an `x-api-key` header.
#
# This is NOT the credential used to call CruDoc. Outbound appointment calls
# authenticate with the per-clinic `api_key` in the clinic's
# config.appointment_provider_config, which must match the VOICE_BOT_API_KEY
# *secret* set on the Cloud Functions side. The two happen to share a name
# and may hold the same value, but they are separate settings in separate
# places -- see the README's "CruDoc integration" section.
VOICE_BOT_API_KEY=

# STT failure fallback threshold (consecutive empty/unintelligible results)
STT_FAILURE_THRESHOLD=2

# Optional specific clinic ID to use for the local voice test browser page
LOCAL_VOICE_TEST_CLINIC_ID=

# Set true to let the browser voice test make real appointment-provider bookings.
LOCAL_VOICE_TEST_ALLOW_BOOKING=false
