{
  "lifecycle": {
    "rule": [
      {
        "action": { "type": "Delete" },
        "condition": { "age": 14, "matchesPrefix": ["voice-scratch/"] }
      },
      {
        "action": { "type": "Delete" },
        "condition": { "age": 90, "matchesSuffix": [".csv"] }
      },
      {
        "action": { "type": "Delete" },
        "condition": { "age": 365, "matchesSuffix": [".enc"] }
      }
    ]
  }
}
