rules_version = '2';

// Firebase Cloud Storage rules for CruDoc.
//
// Every object lives under the owning doctor's uid (the clinic id). The
// client-side counterpart is lib/core/services/medical_storage_service.dart —
// keep the size cap and content-type lists below in sync with it.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(doctorId) {
      return request.auth != null && request.auth.uid == doctorId;
    }

    // Reading or writing a patient's clinical record, as opposed to running
    // the clinic. Keep in sync with clinicalPerm() in firestore.rules.
    function clinicalPerm(perm) {
      return perm == 'clinical.view' || perm == 'clinical.edit';
    }

    // Whether this clinic's admins may reach clinical records. Absent means
    // a clinic created before the setting existed and reads as `true`; see
    // the longer note in firestore.rules.
    function adminClinicalAllowed(doctorId) {
      return firestore.get(/databases/(default)/documents/clinics/$(doctorId))
        .data.get('adminClinicalAccess', true) == true;
    }

    // Clinic membership; see firestore.rules. The clinic id is the owner's uid.
    // The admin role carries every administrative permission but no clinical
    // one unless the owner has granted it.
    function memberAllows(doctorId, perm) {
      let m = firestore.get(/databases/(default)/documents/clinics/$(doctorId)/members/$(request.auth.uid)).data;
      return m.active == true
        && (perm == 'member'
          || (m.roleId == 'admin'
            ? (!clinicalPerm(perm) || adminClinicalAllowed(doctorId))
            : perm in m.perms));
    }

    // A manager-owner (nonClinicalOwner claim, set by ensureClinic) runs the
    // clinic but never opens medical records; see firestore.rules. Read from
    // the token, so a solo doctor is unaffected.
    function nonClinicalOwner() {
      return request.auth.token.get('nonClinicalOwner', false) == true;
    }

    // perm: a permission key, 'member' or 'admin' (owner and admin role only).
    // The owner never falls through to the member check.
    function can(doctorId, perm) {
      return request.auth != null
        && ((request.auth.uid == doctorId
            && (!clinicalPerm(perm) || !nonClinicalOwner()))
          || (request.auth.uid != doctorId && memberAllows(doctorId, perm)));
    }

    // For the catch-all below only. Storage rules are OR'd together, so a
    // blanket `can(doctorId, 'admin')` on doctors/{id}/** would hand an admin
    // every patient file regardless of the narrower clinical rules further
    // down. The owner always passes; an admin passes only while the clinic
    // still lets admins open clinical records.
    function ownerOrFullAdmin(doctorId) {
      return (isOwner(doctorId) && !nonClinicalOwner())
        || (!isOwner(doctorId)
          && can(doctorId, 'admin') && adminClinicalAllowed(doctorId));
    }

    function withinSizeLimit() {
      return request.resource.size <= 15 * 1024 * 1024;
    }

    function isAllowedMedicalType() {
      return request.resource.contentType in [
        'image/jpeg',
        'image/png',
        'image/webp',
        'application/pdf',
        'audio/mp4',
        'audio/aac',
        'audio/opus',
        'text/csv'
      ];
    }

    function isAllowedAudioType() {
      return request.resource.contentType in [
        'audio/mp4',
        'audio/aac',
        'audio/opus'
      ];
    }

    // Default deny: anything not matched below is unreachable.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Permanent per-doctor files: patient records, clinic branding,
    // inventory receipts, sterilization strips, backups, exports.
    // Catch-all: the owner, or an admin who may still open clinical records
    // (this path covers patient folders too, so it cannot be granted to an
    // admin whose clinical access has been withdrawn). The narrower rules
    // below keep giving admins branding, inventory and backup access.
    match /doctors/{doctorId}/{allPaths=**} {
      allow read, delete: if ownerOrFullAdmin(doctorId);
      allow create, update: if ownerOrFullAdmin(doctorId)
        && withinSizeLimit()
        && isAllowedMedicalType();
    }

    // Patient files: clinical media, prescriptions, invoices, avatars.
    match /doctors/{doctorId}/patients/{allPaths=**} {
      allow read: if can(doctorId, 'clinical.view');
      allow create, update: if can(doctorId, 'clinical.edit')
        && withinSizeLimit()
        && isAllowedMedicalType();
      allow delete: if can(doctorId, 'clinical.edit');
    }

    // Patient photos are part of the patient list, so anyone who may see
    // patients sees them (on top of the clinical rule above).
    match /doctors/{doctorId}/patients/{patientId}/avatar/{allPaths=**} {
      allow read: if can(doctorId, 'patients.view');
      allow create, update: if can(doctorId, 'patients.edit')
        && withinSizeLimit()
        && isAllowedMedicalType();
      allow delete: if can(doctorId, 'patients.edit');
    }

    // Invoice PDFs belong to billing: the front desk prints and resends them.
    match /doctors/{doctorId}/patients/{patientId}/invoices/{allPaths=**} {
      allow read, delete: if can(doctorId, 'billing');
      allow create, update: if can(doctorId, 'billing')
        && withinSizeLimit()
        && isAllowedMedicalType();
    }

    // Diagnostic originals from the radiology module: one DICOM instance
    // (or TIFF) per object, stored byte for byte. Larger limit than other
    // files; the type is accepted here only.
    match /doctors/{doctorId}/patients/{patientId}/clinical/imaging/{allPaths=**} {
      allow create, update: if can(doctorId, 'clinical.edit')
        && request.resource.size <= 250 * 1024 * 1024
        && request.resource.contentType in ['application/dicom', 'image/tiff'];
    }

    // Files screen uploads: one object per file, named after its record in
    // `patient_files`. Kept outside doctors/ so the clinic-wide patient-file
    // rule doesn't reach it: who may read a file follows its record (its
    // folder's sharing, see firestore.rules). Written once by the person
    // adding it, which may be before the record has synced. Keep the types
    // and sizes in step with lib/features/files/data/file_types.dart.
    match /patient-files/{doctorId}/{patientId}/{fileId}/{name} {
      function fileRecord() {
        return firestore.get(/databases/(default)/documents/patient_files/$(fileId)).data;
      }

      allow read: if can(doctorId, 'clinical.view')
        && fileRecord().doctorId == doctorId
        && (request.auth.uid in fileRecord().visibleTo
          || 'team' in fileRecord().visibleTo);
      // 'view' is the progressive JPEG a picture is viewed from.
      allow create: if can(doctorId, 'clinical.edit')
        && name == 'view'
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size <= 50 * 1024 * 1024;
      allow create: if can(doctorId, 'clinical.edit')
        && name == 'original'
        && request.resource.contentType in [
          'image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/bmp',
          'image/heic', 'image/heif', 'image/tiff', 'application/dicom',
          'model/stl', 'model/ply', 'model/obj',
          'application/pdf', 'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/vnd.ms-powerpoint',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation',
          'application/vnd.oasis.opendocument.text',
          'application/vnd.oasis.opendocument.spreadsheet',
          'application/rtf', 'text/plain', 'text/csv',
          'video/mp4', 'video/quicktime', 'video/webm',
          'audio/mpeg', 'audio/mp4', 'audio/aac', 'audio/wav', 'audio/ogg'
        ]
        && request.resource.size <= (
          request.resource.contentType in ['application/dicom', 'image/tiff']
            ? 250 : 50) * 1024 * 1024;
      allow delete: if can(doctorId, 'clinical.edit')
        && (!firestore.exists(/databases/(default)/documents/patient_files/$(fileId))
          || fileRecord().ownerUid == request.auth.uid
          || can(doctorId, 'admin'));
    }

    // Clinic blobs: deduplicated stored copies keyed by SHA-256 fingerprint.
    // Bytes live at clinic-blobs/{clinicId}/{sha}/{name} where name is 'original' or 'view'.
    // Read: anyone with clinical.view in that clinic.
    // Create: anyone with clinical.edit in that clinic, create-only (resource == null, no overwrite).
    // No update. No delete (cleanup handled by server function).
    match /clinic-blobs/{clinicId}/{sha}/{name} {
      allow read: if can(clinicId, 'clinical.view');
      allow create: if can(clinicId, 'clinical.edit')
        && resource == null
        && name in ['original', 'view']
        && (
          (name == 'view'
            && request.resource.contentType == 'image/jpeg'
            && request.resource.size <= 50 * 1024 * 1024)
          ||
          (name == 'original'
            && request.resource.contentType in [
              'image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/bmp',
              'image/heic', 'image/heif', 'image/tiff', 'application/dicom',
              'model/stl', 'model/ply', 'model/obj',
              'application/pdf', 'application/msword',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
              'application/vnd.ms-excel',
              'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
              'application/vnd.ms-powerpoint',
              'application/vnd.openxmlformats-officedocument.presentationml.presentation',
              'application/vnd.oasis.opendocument.text',
              'application/vnd.oasis.opendocument.spreadsheet',
              'application/rtf', 'text/plain', 'text/csv',
              'video/mp4', 'video/quicktime', 'video/webm',
              'audio/mpeg', 'audio/mp4', 'audio/aac', 'audio/wav', 'audio/ogg'
            ]
            && request.resource.size <= (
              request.resource.contentType in ['application/dicom', 'image/tiff']
                ? 250 : 50) * 1024 * 1024)
        );
    }

    // Clinic branding (logo, signature)
    match /doctors/{doctorId}/clinic/branding/{allPaths=**} {
      allow read: if can(doctorId, 'member');
      allow create, update: if can(doctorId, 'settings')
        && withinSizeLimit()
        && isAllowedMedicalType();
      allow delete: if can(doctorId, 'settings');
    }

    // A doctor's own signature, stamp and template images. Only that doctor
    // writes; everyone in the clinic reads them (to print documents).
    match /doctors/{doctorId}/doctor-files/{uid}/{allPaths=**} {
      allow read: if can(doctorId, 'member');
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && can(doctorId, 'member')
        && withinSizeLimit()
        && isAllowedMedicalType();
      allow delete: if request.auth != null
        && request.auth.uid == uid
        && can(doctorId, 'member');
    }

    // Inventory receipts and autoclave indicator strips
    match /doctors/{doctorId}/inventory-receipts/{allPaths=**} {
      allow read, delete: if can(doctorId, 'inventory');
      allow create, update: if can(doctorId, 'inventory')
        && withinSizeLimit()
        && isAllowedMedicalType();
    }

    match /doctors/{doctorId}/sterilization-strips/{allPaths=**} {
      allow read, delete: if can(doctorId, 'inventory');
      allow create, update: if can(doctorId, 'inventory')
        && withinSizeLimit()
        && isAllowedMedicalType();
    }

    // Encrypted database backups (.enc) are opaque bytes. octet-stream is
    // accepted here only, so it can't be used to slip arbitrary files into
    // patient folders.
    match /doctors/{doctorId}/backups/{allPaths=**} {
      allow read, delete: if can(doctorId, 'admin');
      allow create, update: if can(doctorId, 'admin')
        && withinSizeLimit()
        && request.resource.contentType == 'application/octet-stream';
    }

    // Files attached to a referral sent to another doctor, uploaded by the
    // sender before the referralNetwork function records them. Write-once,
    // so a file can't be swapped after it was sent. Nobody reads them here:
    // both doctors get a short-lived link from the function instead, which
    // checks the share and writes an access log. Keep the size and types in
    // sync with MAX_ATTACHMENT_BYTES / ATTACHMENT_TYPES in referrals.ts.
    match /referral_uploads/{uid}/{shareId}/{fileName} {
      allow create: if isOwner(uid)
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'image/jpeg',
          'image/png',
          'image/webp',
          'application/dicom'
        ];
      allow read, update, delete: if false;
    }

    // Ephemeral voice dictation awaiting transcription. Write-once:
    // no update, so a recording can't be swapped after upload.
    match /voice-scratch/doctors/{doctorId}/{allPaths=**} {
      allow read, delete: if isOwner(doctorId);
      allow create: if isOwner(doctorId)
        && withinSizeLimit()
        && isAllowedAudioType();
    }
  }
}
