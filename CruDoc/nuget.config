<?xml version="1.0" encoding="utf-8"?>
<!-- The Windows build of geolocator fetches C++/WinRT from NuGet. This keeps
     that working on machines whose own NuGet config lists no sources. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
