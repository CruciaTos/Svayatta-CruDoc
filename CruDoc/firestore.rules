rules_version = '2';

// Firestore rules for CruDoc.
//
// Clinical data lives in top-level collections, one document per record,
// keyed by `doctorId` = clinic id (= owner uid); members of that clinic may
// use them according to their permissions.
// Every list query filters on `doctorId == clinicId`.
//
// Super Admin manages accounts, plans and settings but is denied patient data.
// Cloud Functions use the Admin SDK and are not affected by these rules.
//
// Tests: tests/firestore-rules (run with the Firestore emulator).
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated()
        && request.auth.token.role == 'superAdmin'
        && request.auth.token.isTwoFAVerified == true;
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ------------------------------------------------------------
    // CLINIC MEMBERSHIP
    // ------------------------------------------------------------
    // A clinic's id is its owner's uid, so records stamped
    // doctorId == <owner uid> before clinics existed already belong to it.
    // Other doctors and staff are clinics/{clinicId}/members/{uid}, written
    // only by the clinicTeam Cloud Function. The member doc is read on each
    // request, so a removed member loses access at once.

    function memberPath(clinicId) {
      return /databases/$(database)/documents/clinics/$(clinicId)/members/$(request.auth.uid);
    }

    // Reading or writing a patient's clinical record, as opposed to running
    // the clinic. Keep in sync with CLINICAL_PERMS in functions/src/clinic.ts
    // and clinicalPerm() in storage.rules.
    function clinicalPerm(perm) {
      return perm == 'clinical.view' || perm == 'clinical.edit';
    }

    // Whether this clinic's admins may reach clinical records. An absent
    // field means a clinic created before the setting existed and is read as
    // `true`, so a clinic whose backfill has not run is never locked out of
    // its own records; once migrate_admin_clinical_access.js has been
    // applied everywhere this default should become `false`. Only consulted
    // for an admin asking for a clinical permission, so the extra get()
    // stays off every other path.
    function adminClinicalAllowed(clinicId) {
      return get(/databases/$(database)/documents/clinics/$(clinicId))
        .data.get('adminClinicalAccess', true) == true;
    }

    // The admin role carries every administrative permission but no clinical
    // one unless the owner has granted it: being able to run the clinic is
    // not the same as being able to read its charts. 'admin' as a pseudo-perm
    // is administrative, so the admin role still passes it.
    function memberAllows(clinicId, perm) {
      let m = get(memberPath(clinicId)).data;
      return m.active == true
        && (perm == 'member'
          || (m.roleId == 'admin'
            ? (!clinicalPerm(perm) || adminClinicalAllowed(clinicId))
            : perm in m.perms));
    }

    // A manager who owns the clinic (set up as "I manage the clinic", not as
    // a doctor) carries the nonClinicalOwner claim, set by ensureClinic. They
    // run the clinic but never open medical records — not even through the
    // admins' clinical-access setting, which is theirs to grant to others.
    // Read from the token, so a solo doctor, who never carries it, pays no
    // extra document read and sees no change at all.
    function ownerAllows(perm) {
      return !clinicalPerm(perm)
        || request.auth.token.get('nonClinicalOwner', false) != true;
    }

    // perm: a permission key, 'member' (any active member) or 'admin'
    // (not a real permission, so only the owner and the admin role pass).
    // The owner is decided by ownerAllows alone and never falls through to
    // the member check (no ternary, for the reason given at scopeAllowsGet).
    function clinicAllows(clinicId, perm) {
      return isAuthenticated()
        && ((request.auth.uid == clinicId && ownerAllows(perm))
          || (request.auth.uid != clinicId && memberAllows(clinicId, perm)));
    }

    // ------------------------------------------------------------
    // PATIENT ASSIGNMENT
    // ------------------------------------------------------------
    // A clinic may scope its doctors to the patients they treat, by setting
    // clinicalAccessScope to 'assigned'. Default 'clinic': every doctor sees
    // every patient, which is how a small practice covers walk-ins and
    // absences, and is what every clinic did before this field existed.
    //
    // Scoping applies only to doctor-kind members. The front desk needs the
    // whole list to run the appointment book, and the owner is never scoped.
    // A patient with no assignment stays visible to all doctors, so a newly
    // registered walk-in is never invisible to the person about to see them.
    //
    // Both get() calls below resolve the same path for every document in a
    // list query (the clinic and the caller's own member doc), so they cost
    // one lookup each rather than one per result.

    function clinicScopesDoctors(clinicId) {
      return get(/databases/$(database)/documents/clinics/$(clinicId))
        .data.get('clinicalAccessScope', 'clinic') == 'assigned';
    }

    function callerIsScopedDoctor(clinicId) {
      return request.auth.uid != clinicId
        && get(memberPath(clinicId)).data.get('kind', 'staff') == 'doctor';
    }

    // Whether scoping applies at all to this request. The caller's own member
    // doc is checked first — clinicAllows has already read it, so it costs
    // nothing more — and only a doctor goes on to read the clinic. Both are
    // other documents, which a query rule can read, unlike the fields of the
    // documents being listed.
    function notScoped(clinicId) {
      return !callerIsScopedDoctor(clinicId) || !clinicScopesDoctors(clinicId);
    }

    // A patient this caller may reach: nobody in particular is assigned (so
    // a walk-in just registered at the desk is never invisible to the person
    // about to see them), or the caller is one of the assigned doctors.
    function assignedOrOpen(p) {
      return !('assignedDoctorUids' in p)
        || p.assignedDoctorUids.size() == 0
        || request.auth.uid in p.assignedDoctorUids;
    }

    // Single-document reads and writes of a patient, where the whole stored
    // document is available.
    function patientScopeAllowsGet(d) {
      return notScoped(d.doctorId) || assignedOrOpen(d);
    }

    // Queries. A rule for a query is satisfied from the query's own filters
    // rather than by reading each result, so a field the query does not
    // constrain is simply absent here — which means any permissive fallback
    // on it would let an unfiltered query through. This is therefore written
    // to deny unless the query itself narrows to the caller:
    //   where('assignedDoctorUids', 'array-contains', uid)
    // A scoped doctor's patient list is thus the patients assigned to them;
    // unassigned patients remain reachable by id (see above).
    function patientScopeAllowsList(d) {
      return notScoped(d.doctorId)
        || request.auth.uid in d.assignedDoctorUids;
    }

    // ---- clinical records ----------------------------------------
    // A scoped doctor reaches a clinical record only through its patient:
    // the same doctors who may open the patient may open their records.

    function isClinicalRecord(collection) {
      return collection in [
        'dental_records',
        'radiology_docs',
        'homeopathy_case_sheets',
        'homeopathy_session_notes',
        'tooth_chart_entries',
        'procedure_log_entries',
        'treatment_plan_line_items'
      ];
    }

    // The record's patient, which must be a patient of the same clinic — a
    // record pointing at another clinic's patient must not borrow that
    // patient's assignment. A missing patient fails the read, which denies:
    // a scoped doctor never reaches a record whose patient cannot be checked.
    function recordPatientAllows(d) {
      let p = get(/databases/$(database)/documents/patients/$(d.patientId)).data;
      return p.doctorId == d.doctorId && assignedOrOpen(p);
    }

    function clinicalScopeAllowsGet(d) {
      return notScoped(d.doctorId) || recordPatientAllows(d);
    }

    // Two kinds of query pass for a scoped doctor:
    //  - one narrowed to a single patient (where patientId == P), which is how
    //    a patient's own screen reads their records; the patient is then known
    //    from the query and can be checked;
    //  - one narrowed to the caller (where assignedDoctorUids array-contains
    //    uid), which is how the clinic-wide sync reads them. Records carry a
    //    copy of their patient's assignment for this, kept current by the
    //    stampClinicalAssignment / fanOutPatientAssignment functions.
    // Any other query cannot be judged per record, and is refused.
    function clinicalScopeAllowsList(d) {
      return notScoped(d.doctorId)
        || request.auth.uid in d.assignedDoctorUids
        || recordPatientAllows(d);
    }

    // ---- who may set an assignment ---------------------------------
    // assignedDoctorUids is server-owned: the assignPatient function checks
    // that only active doctors are assigned and that a scoped doctor is not
    // assigning themselves. A client may set it only when creating a
    // patient, and then only to nobody or to itself (a doctor registering
    // their own patient). On clinical records it is never a client's to set.

    // Absent is always fine; present is allowed only on a patient, and then
    // only as nobody or the caller alone. No ternary, for the reason given at
    // scopeAllowsGet below.
    function createSetsOnlySelfAssignment(collection, d) {
      return !('assignedDoctorUids' in d)
        || (collection == 'patients'
          && (d.assignedDoctorUids.size() == 0
            || (d.assignedDoctorUids.size() == 1
              && d.assignedDoctorUids[0] == request.auth.uid)));
    }

    function updateKeepsAssignment() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['assignedDoctorUids']);
    }

    // ---- applied per collection ----------------------------------

    // Written with && / || rather than `collection == 'patients' ? … : …`.
    // The equivalent ternary made the Firestore emulator's rules engine hang
    // on every write to `patients` (found by bisecting the rules), which
    // would have left these rules untestable.
    function scopeAllowsGet(collection, d) {
      return (collection != 'patients' || patientScopeAllowsGet(d))
        && (!isClinicalRecord(collection) || clinicalScopeAllowsGet(d));
    }

    function scopeAllowsList(collection, d) {
      return (collection != 'patients' || patientScopeAllowsList(d))
        && (!isClinicalRecord(collection) || clinicalScopeAllowsList(d));
    }

    // Creating a patient is never scoped (anyone with patients.edit may
    // register one). Creating a clinical record is: it must be for a
    // patient the caller may reach.
    function scopeAllowsCreate(collection, d) {
      return !isClinicalRecord(collection) || clinicalScopeAllowsGet(d);
    }

    function readPerm(collection) {
      return {
        'patients': 'patients.view',
        'appointments': 'schedule',
        'visitations': 'schedule',
        'walk_in_queue': 'schedule',
        'invoices': 'billing',
        'pending_payments': 'billing',
        'revenue_entries': 'revenue',
        'medicines': 'inventory',
        'stock_transactions': 'inventory',
        'sterilization_log_entries': 'inventory',
        'dental_records': 'clinical.view',
        'radiology_docs': 'clinical.view',
        'homeopathy_case_sheets': 'clinical.view',
        'homeopathy_session_notes': 'clinical.view',
        'consultation_notes': 'clinical.view',
        'tooth_chart_entries': 'clinical.view',
        'procedure_log_entries': 'clinical.view',
        'treatment_plan_line_items': 'clinical.view',
        'dental_procedure_catalog': 'member'
      }[collection];
    }

    function writePerm(collection) {
      return {
        'patients': 'patients.edit',
        'appointments': 'schedule',
        'visitations': 'schedule',
        'walk_in_queue': 'schedule',
        'invoices': 'billing',
        'pending_payments': 'billing',
        'revenue_entries': 'billing',
        'medicines': 'inventory',
        'stock_transactions': 'inventory',
        'sterilization_log_entries': 'inventory',
        'dental_records': 'clinical.edit',
        'radiology_docs': 'clinical.edit',
        'homeopathy_case_sheets': 'clinical.edit',
        'homeopathy_session_notes': 'clinical.edit',
        'consultation_notes': 'clinical.edit',
        'tooth_chart_entries': 'clinical.edit',
        'procedure_log_entries': 'clinical.edit',
        'treatment_plan_line_items': 'clinical.edit',
        'dental_procedure_catalog': 'settings'
      }[collection];
    }

    // The stored document belongs to the caller (or doesn't exist yet, so a
    // get or delete reveals nothing).
    function ownsExisting() {
      return resource == null || resource.data.doctorId == request.auth.uid;
    }

    // The document being written is stamped with the caller's uid.
    function writesOwnDoctorId() {
      return request.resource.data.doctorId == request.auth.uid;
    }

    // Top-level collections holding one doctor's records, keyed by `doctorId`.
    function isDoctorOwnedCollection(collection) {
      return collection in [
        'patients',
        'appointments',
        'visitations',
        'walk_in_queue',
        'invoices',
        'revenue_entries',
        'pending_payments',
        'medicines',
        'stock_transactions',
        'dental_records',
        'radiology_docs',
        'homeopathy_case_sheets',
        'homeopathy_session_notes',
        'consultation_notes',
        'dental_procedure_catalog',
        'tooth_chart_entries',
        'procedure_log_entries',
        'sterilization_log_entries',
        'treatment_plan_line_items'
      ];
    }

    // ============================================================
    // DOCTOR-OWNED CLINICAL COLLECTIONS - STRICT ISOLATION
    // ============================================================
    // Super Admin is deliberately absent: it never reads patient data.

    match /{collection}/{docId} {
      allow get: if isDoctorOwnedCollection(collection)
        && isAuthenticated()
        && (resource == null
          || (clinicAllows(resource.data.doctorId, readPerm(collection))
            && scopeAllowsGet(collection, resource.data)));
      allow list: if isDoctorOwnedCollection(collection)
        && clinicAllows(resource.data.doctorId, readPerm(collection))
        && scopeAllowsList(collection, resource.data);
      allow create: if isDoctorOwnedCollection(collection)
        && clinicAllows(request.resource.data.doctorId, writePerm(collection))
        && createSetsOnlySelfAssignment(collection, request.resource.data)
        && scopeAllowsCreate(collection, request.resource.data);
      // doctorId can't be changed, so a record can't move between clinics.
      // A clinical record is checked against its patient both before and
      // after, so it cannot be moved onto a patient the caller cannot reach.
      allow update: if isDoctorOwnedCollection(collection)
        && request.resource.data.doctorId == resource.data.doctorId
        && clinicAllows(resource.data.doctorId, writePerm(collection))
        && updateKeepsAssignment()
        && scopeAllowsGet(collection, resource.data)
        && scopeAllowsCreate(collection, request.resource.data);
      allow delete: if isDoctorOwnedCollection(collection)
        && isAuthenticated()
        && (resource == null
          || (clinicAllows(resource.data.doctorId, writePerm(collection))
            && scopeAllowsGet(collection, resource.data)));
    }

    // ============================================================
    // FILES SCREEN - PER-PERSON FOLDERS AND PATIENT FILES
    // ============================================================
    // Unlike the clinic-wide collections above, each folder and file is
    // seen only by the people in its `visibleTo`: person uids, plus 'team'
    // for everyone in the clinic with clinical access. A top-level folder
    // (rootId == its own id) carries the sharing; folders and files inside
    // it copy its visibleTo and point rootId at it. A file in no folder
    // (rootId == '') is its owner's alone. Clients list with
    // where('doctorId', '==', clinic) and
    // where('visibleTo', 'array-contains', uid or 'team').
    // Records are soft-deleted (isDeleted), never removed.

    function seesFileRecord(d) {
      return request.auth.uid in d.visibleTo || 'team' in d.visibleTo;
    }

    // The top-level folder of [d], as it will be once this write is done.
    function fileRootAfter(d) {
      return getAfter(/databases/$(database)/documents/file_folders/$(d.rootId)).data;
    }

    // [d]'s visibility is the one it must have: its top-level folder's, or
    // (no folder) only its owner.
    function followsRoot(d) {
      return d.rootId == ''
        ? d.visibleTo == [d.ownerUid]
        : fileRootAfter(d).doctorId == d.doctorId
          && fileRootAfter(d).visibleTo == d.visibleTo;
    }

    // Who may change a record: its owner, the owner of the top-level
    // folder it is in, or a clinic admin.
    function managesFileRecord(d) {
      return request.auth.uid == d.ownerUid
        || clinicAllows(d.doctorId, 'admin')
        || (d.rootId != ''
          && get(/databases/$(database)/documents/file_folders/$(d.rootId)).data.ownerUid == request.auth.uid);
    }

    function validFolder(d, folderId) {
      return d.ownerUid is string
        && d.name is string && d.name.size() <= 2000
        && d.parentId is string
        && d.sharing in ['private', 'team', 'people']
        && d.visibleTo is list && d.visibleTo.size() <= 50
        && (d.rootId == folderId
          // Top level: carries the sharing; the owner always sees it.
          ? d.parentId == '' && d.ownerUid in d.visibleTo
          : d.parentId != '' && followsRoot(d));
    }

    function validFile(d) {
      return d.ownerUid is string
        && d.patientId is string && d.patientId.size() > 0
        && d.patientId.size() <= 128
        && d.name is string && d.name.size() <= 2000
        && d.folderId is string && d.rootId is string
        && (d.folderId == '') == (d.rootId == '')
        && d.contentType is string
        && d.sizeBytes is int
        && d.storagePath is string
        && d.visibleTo is list && d.visibleTo.size() <= 50
        && followsRoot(d);
    }

    match /file_folders/{folderId} {
      allow get: if isAuthenticated()
        && (resource == null
          || (clinicAllows(resource.data.doctorId, 'clinical.view')
            && seesFileRecord(resource.data)));
      allow list: if clinicAllows(resource.data.doctorId, 'clinical.view')
        && seesFileRecord(resource.data);
      allow create: if clinicAllows(request.resource.data.doctorId, 'clinical.edit')
        && request.resource.data.ownerUid == request.auth.uid
        && seesFileRecord(request.resource.data)
        && validFolder(request.resource.data, folderId);
      allow update: if clinicAllows(resource.data.doctorId, 'clinical.edit')
        && seesFileRecord(resource.data)
        && managesFileRecord(resource.data)
        && request.resource.data.doctorId == resource.data.doctorId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validFolder(request.resource.data, folderId);
      allow delete: if false;
    }

    match /patient_files/{fileId} {
      allow get: if isAuthenticated()
        && (resource == null
          || (clinicAllows(resource.data.doctorId, 'clinical.view')
            && seesFileRecord(resource.data)));
      allow list: if clinicAllows(resource.data.doctorId, 'clinical.view')
        && seesFileRecord(resource.data);
      // Adding to a folder needs only that the folder is shared with you.
      allow create: if clinicAllows(request.resource.data.doctorId, 'clinical.edit')
        && request.resource.data.ownerUid == request.auth.uid
        && seesFileRecord(request.resource.data)
        && validFile(request.resource.data);
      allow update: if clinicAllows(resource.data.doctorId, 'clinical.edit')
        && seesFileRecord(resource.data)
        && managesFileRecord(resource.data)
        && request.resource.data.doctorId == resource.data.doctorId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validFile(request.resource.data);
      allow delete: if false;
    }

    // ============================================================
    // PATIENT ACCESS LOG - APPEND ONLY
    // ============================================================
    // Written by AccessAuditService when a patient record is opened or a
    // stored file is downloaded. A doctor can add entries in their own name
    // and read their own log; nobody can change or delete an entry.

    match /access_logs/{logId} {
      // Super Admin sees only the team events the clinicTeam function writes
      // (platform == 'server'), never patient.view / file.download entries.
      // Query with where('platform', '==', 'server').
      allow get: if isAuthenticated() && (resource == null || clinicAllows(resource.data.doctorId, 'team')
        || (isSuperAdmin() && resource.data.platform == 'server'));
      allow list: if clinicAllows(resource.data.doctorId, 'team')
        || (isSuperAdmin() && resource.data.platform == 'server');
      allow create: if isAuthenticated()
        && clinicAllows(request.resource.data.doctorId, 'member')
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action in ['patient.view', 'file.download']
        && request.resource.data.keys().hasOnly(
          ['doctorId', 'actorUid', 'action', 'patientId', 'target', 'platform', 'at']);
      allow update, delete: if false;
    }

    // ============================================================
    // PER-DOCTOR ENCRYPTION KEYS
    // ============================================================
    // The wrapped data key for a doctor. Created once by that doctor's app,
    // never changed or deleted from a client.

    match /doctor_keys/{doctorId} {
      allow get: if isSelf(doctorId) || clinicAllows(doctorId, 'member');
      allow create: if isSelf(doctorId)
        && request.resource.data.keys().hasOnly(['wrappedKey', 'createdAt'])
        && request.resource.data.wrappedKey is string;
      allow update, delete: if false;
    }

    // ============================================================
    // WHATSAPP - REMINDER DELIVERY LOG
    // ============================================================
    // Written only by Cloud Functions, which send the reminders and receive
    // Meta's delivery receipts. A doctor reads their own rows to see whether a
    // patient got their reminder, and cannot write them: a status the app
    // could set would say nothing about what Meta actually did.

    // ============================================================
    // AI RECEPTIONIST (functions/src/voice) - WRITTEN BY FUNCTIONS
    // ============================================================
    // Lines, calls and usage are what the voiceApi function did, so the app
    // only reads them, with the 'ai' permission. Callback cards are
    // reception's to-do list: readable with 'schedule' or 'ai', and the only
    // client change is marking one done (or reopening it). Slot locks are
    // internal to booking and seen by nobody. Super Admin sees lines and usage
    // (billing), never calls or callbacks, which hold patient details.

    function aiStaff(clinicId) {
      return clinicAllows(clinicId, 'ai') || clinicAllows(clinicId, 'schedule');
    }

    match /voice_lines/{lineId} {
      allow get: if isSuperAdmin() || (isAuthenticated()
        && (resource == null || clinicAllows(resource.data.doctorId, 'ai')));
      allow list: if isSuperAdmin() || clinicAllows(resource.data.doctorId, 'ai');
      allow write: if false;
    }

    match /voice_usage/{usageId} {
      allow get: if isSuperAdmin() || (isAuthenticated()
        && (resource == null || clinicAllows(resource.data.doctorId, 'ai')));
      allow list: if isSuperAdmin() || clinicAllows(resource.data.doctorId, 'ai');
      allow write: if false;
    }

    match /voice_calls/{callId} {
      allow get: if isAuthenticated()
        && (resource == null || clinicAllows(resource.data.doctorId, 'ai'));
      allow list: if clinicAllows(resource.data.doctorId, 'ai');
      allow write: if false;
    }

    match /voice_callbacks/{callbackId} {
      allow get: if isAuthenticated()
        && (resource == null || aiStaff(resource.data.doctorId));
      allow list: if aiStaff(resource.data.doctorId);
      allow update: if aiStaff(resource.data.doctorId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'doneAt', 'doneBy'])
        && request.resource.data.status in ['open', 'done']
        && (!('doneBy' in request.resource.data)
          || request.resource.data.doneBy == null
          || request.resource.data.doneBy == request.auth.uid);
      allow create, delete: if false;
    }

    match /slot_locks/{lockId} {
      allow read, write: if false;
    }

    match /whatsapp_notification_logs/{logId} {
      allow get: if isAuthenticated() && (resource == null || clinicAllows(resource.data.doctorId, 'messaging'));
      allow list: if clinicAllows(resource.data.doctorId, 'messaging');
      allow create, update, delete: if false;

      // Every raw delivery event, kept for working out what happened.
      match /events/{eventId} {
        allow read: if isAuthenticated()
          && clinicAllows(get(/databases/$(database)/documents/whatsapp_notification_logs/$(logId)).data.doctorId, 'messaging');
        allow write: if false;
      }
    }

    // What patients wrote back to the reminder number. Only the server
    // writes; the clinic reads them in Notifications.
    match /whatsapp_replies/{replyId} {
      allow get, list: if clinicAllows(resource.data.doctorId, 'messaging');
      allow write: if false;
    }

    // Patients who replied STOP. Keyed by phone number and shared across all
    // clinics, so it is never readable by a doctor: it would expose that a
    // given number belongs to someone who also sees another practice.
    match /whatsapp_optouts/{phone} {
      allow read, write: if false;
    }

    // Rate limiting for the auto-reply, keyed by phone. Same reasoning.
    match /whatsapp_autoreplies/{phone} {
      allow read, write: if false;
    }

    // ============================================================
    // WHATSAPP - PER-CLINIC CREDENTIALS AND ROUTING
    // ============================================================
    // Dormant at launch: reminders go from one shared CruDoc number. These
    // stay closed so the collections cannot be written into existence from a
    // client before the per-clinic upgrade lands.
    // Each clinic connects their own WhatsApp number, so these hold the keys
    // to messaging that clinic's patients. Cloud Functions reach them with the
    // Admin SDK, which bypasses rules; nothing else may ever touch them.
    //
    // The tokens themselves live in Secret Manager, not here. These documents
    // still name the secret and identify the WhatsApp account, so they stay
    // closed to every client.

    match /whatsapp_tenants/{doctorId}/{rest=**} {
      allow read, write: if false;
    }

    // Maps a sent message id back to its clinic so delivery receipts can be
    // routed. Reading it would expose other clinics' message ids.
    match /whatsapp_message_index/{messageId} {
      allow read, write: if false;
    }

    // Short-lived nonces binding an onboarding browser session to a doctor.
    // A readable nonce would let someone attach their own WhatsApp account to
    // another doctor.
    match /whatsapp_onboarding_sessions/{nonce} {
      allow read, write: if false;
    }

    // What the app shows on the Connect WhatsApp screen: connection state, the
    // clinic's own number, template approval. No secrets. Server writes only,
    // so a doctor cannot mark themselves connected.
    match /whatsapp_connections/{doctorId} {
      allow get: if isSelf(doctorId) || clinicAllows(doctorId, 'messaging');
      allow list, write: if false;
    }

    // ============================================================
    // REFERRALS BETWEEN DOCTORS
    // ============================================================
    // Written only by the referralNetwork Cloud Function
    // (functions/src/referrals.ts). A share is the copy of one referral one
    // doctor sent another: exactly those two people read it, nobody else in
    // either clinic, and never Super Admin. Clients list with
    // where('senderUid', '==', uid) or where('recipientUid', '==', uid).

    match /referral_shares/{shareId} {
      allow get: if isAuthenticated()
        && (resource == null
          || request.auth.uid == resource.data.senderUid
          || request.auth.uid == resource.data.recipientUid);
      allow list: if isAuthenticated()
        && (resource.data.senderUid == request.auth.uid
          || resource.data.recipientUid == request.auth.uid);
      allow write: if false;
    }

    // Doctors who chose to be found by other doctors. A card that is not
    // listed is visible to its owner only. Clients search with
    // where('listed', '==', true) and searchTokens array-contains.
    match /doctor_directory/{uid} {
      allow get: if isAuthenticated()
        && (resource == null || resource.data.listed == true || isSelf(uid));
      allow list: if isAuthenticated() && resource.data.listed == true;
      allow write: if false;
    }

    // Which uid holds each @handle; the function's uniqueness check only.
    match /doctor_handles/{handle} {
      allow read, write: if false;
    }

    // ============================================================
    // CLINICS, MEMBERS, ROLES, INVITES
    // ============================================================
    // Written by the clinicTeam Cloud Function (Admin SDK). A member may
    // edit only their own public profile fields.

    match /clinics/{clinicId} {
      allow get: if isSuperAdmin() || clinicAllows(clinicId, 'member');
      allow list: if isSuperAdmin();
      allow update: if clinicAllows(clinicId, 'settings')
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'updatedAt']);
      allow create, delete: if false;

      match /members/{uid} {
        // Super Admin monitors who works in each clinic (read only).
        allow read: if isSuperAdmin() || clinicAllows(clinicId, 'member');
        allow update: if isSelf(uid)
          && resource.data.active == true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'qualification', 'registrationNo', 'modules'])
          && (!('modules' in request.resource.data)
            || (request.resource.data.modules is list
              && request.resource.data.modules.size() <= 30));
        allow create, delete: if false;
      }

      match /roles/{roleId} {
        allow read: if isSuperAdmin() || clinicAllows(clinicId, 'member');
        allow write: if false;
      }

      match /invites/{inviteId} {
        allow read: if isSuperAdmin() || clinicAllows(clinicId, 'team');
        allow write: if false;
      }
    }

    // Super Admin clinic overview: one collection-group read per kind instead
    // of one query per clinic. Read only; nothing here lets anyone else in.
    match /{path=**}/members/{uid} {
      allow read: if isSuperAdmin();
    }

    match /{path=**}/invites/{inviteId} {
      allow read: if isSuperAdmin();
    }

    // Every person's daily API usage at once, for the Super Admin console.
    match /{path=**}/api_usage/{day} {
      allow read: if isSuperAdmin();
    }

    // ============================================================
    // USERS COLLECTION
    // ============================================================

    match /users/{userId} {
      // A doctor reads their own profile. The email match lets the login
      // screen find a profile the Super Admin created before first sign-in.
      allow get: if isSuperAdmin()
        || isSelf(userId)
        || (isAuthenticated() && resource.data.email == request.auth.token.email);
      allow list: if isSuperAdmin()
        || (isAuthenticated() && resource.data.email == request.auth.token.email);

      // Subscription/entitlement fields are written only by the
      // youpiWebhook (a verified UPI payment) / startDoctorTrial Cloud Functions (admin
      // SDK, which bypasses these rules). A doctor must never set them on
      // their own profile, or they could unlock every paid module for free.
      // Keep in sync with functions/src/subscription.ts.
      // A signed-in user may create their own profile, but never as an admin
      // and never with its own entitlements.
      allow create: if isSuperAdmin()
        || (isSelf(userId)
          && (!('role' in request.resource.data)
            || request.resource.data.role == 'doctor')
          && !request.resource.data.keys().hasAny([
            'clinicId', 'memberKind',
            'enabledModules', 'expiresDate', 'status', 'subscriptionPlan',
            'allowMultiDevice', 'lastPaymentDate', 'lastTransactionId',
            'lastPaymentAmount', 'lastPaymentMethod', 'trialStartedAt']));
      allow update: if isSuperAdmin()
        || (isSelf(userId)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
              || (request.resource.data.role == 'doctor' && (!('role' in resource.data) || resource.data.role == 'doctor')))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'clinicId', 'memberKind',
            'enabledModules', 'expiresDate', 'status', 'subscriptionPlan',
            'allowMultiDevice', 'lastPaymentDate', 'lastTransactionId',
            'lastPaymentAmount', 'lastPaymentMethod', 'trialStartedAt']));
      allow delete: if isSuperAdmin();

      // Everything a doctor keeps under their own profile: device sessions,
      // scribe notes (medical_records), campaigns and their recipients, and
      // the legacy per-doctor subcollections.
      // clinic_invites is the exception: only the clinicTeam function writes
      // a person's invite inbox (see below), so it can't be faked to them.
      match /{subcollection}/{rest=**} {
        allow read, write: if isSelf(userId) && subcollection != 'clinic_invites';
      }

      // Clinic invites waiting for this person. Their app listens here so an
      // invite pops up the moment it is sent; accepting still goes through
      // the clinicTeam function, which checks the real invite.
      match /clinic_invites/{inviteId} {
        allow read: if isSelf(userId);
      }

      // Super Admin can see and revoke a doctor's device sessions.
      match /active_sessions/{sessionId} {
        allow read, delete: if isSuperAdmin();
      }

      // Super Admin sees which features each doctor uses (trial tracking).
      match /feature_usage/{moduleKey} {
        allow read: if isSuperAdmin();
      }

      // Super Admin adds up the paid-API calls each person's app records
      // (Gemini, Sarvam, WhatsApp, Google Places and Maps). Counters only.
      match /api_usage/{day} {
        allow read: if isSuperAdmin();
      }
    }

    // ============================================================
    // SUBSCRIPTIONS, FEATURE FLAGS, DOCTOR SETTINGS
    // ============================================================

    match /subscriptions/{doctorId} {
      allow read: if isSuperAdmin() || isSelf(doctorId) || clinicAllows(doctorId, 'admin');
      allow write: if isSuperAdmin();
    }

    match /feature_flags/{doctorId} {
      allow read: if isSuperAdmin() || isSelf(doctorId) || clinicAllows(doctorId, 'member');
      allow write: if isSuperAdmin();
    }

    match /doctor_settings/{doctorId} {
      allow read: if isSuperAdmin() || isSelf(doctorId) || clinicAllows(doctorId, 'member');
      allow write: if isSuperAdmin();
    }

    // ============================================================
    // PAYMENTS AND UPGRADE REQUESTS
    // ============================================================

    // Receipts are written only by the youpiWebhook function, once a UPI
    // payment is verified. A client-written receipt would show Super Admin a
    // "success" that no money stands behind.
    match /payment_transactions/{transactionId} {
      allow read: if isSuperAdmin()
        || (isAuthenticated() && resource.data.doctorId == request.auth.uid);
      allow create: if false;
      allow update, delete: if isSuperAdmin();
    }

    // One UPI checkout for a plan (functions/src/plan-payments.ts). The app
    // watches its own to learn the outcome; only the functions write them.
    // Query with where('doctorId', '==', uid).
    match /plan_payments/{orderId} {
      allow get: if isAuthenticated()
        && (resource == null || resource.data.doctorId == request.auth.uid
          || isSuperAdmin());
      allow list: if isSuperAdmin()
        || (isAuthenticated() && resource.data.doctorId == request.auth.uid);
      allow write: if false;
    }

    match /upgrade_requests/{requestId} {
      allow read: if isSuperAdmin()
        || (isAuthenticated() && resource.data.doctorId == request.auth.uid);
      allow create: if isAuthenticated() && writesOwnDoctorId();
      allow update, delete: if isSuperAdmin();
    }

    // ============================================================
    // PLANS COLLECTION
    // ============================================================

    match /plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ============================================================
    // AUDIT LOGS COLLECTION
    // ============================================================
    // IMMUTABLE: Only Super Admin can read. No one can change or delete.

    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // ============================================================
    // ANALYTICS COLLECTION
    // ============================================================
    // Written by scheduled Cloud Functions.

    match /analytics/{docId} {
      allow read, create, update: if isSuperAdmin();
      allow delete: if false;  // Historical data should not be deleted
    }

    // ============================================================
    // NOTIFICATIONS COLLECTION
    // ============================================================

    match /notifications/{notificationId} {
      allow read: if isSuperAdmin()
        || (isAuthenticated() && resource.data.doctorId == request.auth.uid);
      allow create, delete: if isSuperAdmin();
      // The doctor may mark their own notification as read.
      allow update: if isSuperAdmin()
        || (isAuthenticated()
          && resource.data.doctorId == request.auth.uid
          && writesOwnDoctorId());
    }

    // ============================================================
    // SUPPORT TICKETS COLLECTION
    // ============================================================

    match /support_tickets/{ticketId} {
      allow read: if isSuperAdmin()
        || (isAuthenticated() && resource.data.doctorId == request.auth.uid);
      allow create: if isAuthenticated() && writesOwnDoctorId();
      allow update: if isSuperAdmin()
        || (isAuthenticated()
          && resource.data.doctorId == request.auth.uid
          && writesOwnDoctorId());
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // API KEYS, API LOGS, SYSTEM CONFIG
    // ============================================================

    match /api_keys/{keyId} {
      allow read, write: if isSuperAdmin();
    }

    match /api_logs/{logId} {
      allow read, write: if isSuperAdmin();
    }

    match /system_config/{configId} {
      allow read, write: if isSuperAdmin();
    }

    // Keys the doctor's app itself uses (the Google Maps key), copied here
    // when the super admin saves API settings. Any signed-in user can read
    // them; only the super admin writes (above).
    match /system_config/client_keys {
      allow read: if isAuthenticated();
    }

    // ============================================================
    // DENY ALL OTHER ACCESS
    // ============================================================
    // Collections not listed above are unreachable from clients.
  }
}
